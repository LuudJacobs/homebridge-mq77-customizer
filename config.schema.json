{
  "pluginAlias": "Mq77Customizer",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Only the broker, the sources and the web interface are set here. Everything else, which devices reach HomeKit and what they do between them, is set in the plugin's own web interface: save this, restart Homebridge, then open the address shown in the Homebridge log.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "MQ77 Customizer",
        "required": true
      },
      "broker": {
        "title": "MQTT Broker",
        "type": "object",
        "properties": {
          "address": {
            "title": "Address",
            "type": "string",
            "default": "localhost:1883",
            "required": true,
            "description": "Host and port. The port may be left off, in which case 1883 is used."
          },
          "requiresAuth": {
            "title": "Requires authentication",
            "type": "boolean",
            "default": false
          },
          "username": {
            "title": "Username",
            "type": "string",
            "condition": {
              "functionBody": "return model.broker && model.broker.requiresAuth;"
            }
          },
          "password": {
            "title": "Password",
            "type": "string",
            "x-schema-form": {
              "type": "password"
            },
            "condition": {
              "functionBody": "return model.broker && model.broker.requiresAuth;"
            }
          },
          "clientId": {
            "title": "Client ID",
            "type": "string",
            "description": "Leave empty to generate one."
          }
        }
      },
      "sources": {
        "title": "Sources",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "ID",
              "type": "string",
              "required": true,
              "description": "Stable identifier. Changing it orphans everything configured against this source."
            },
            "rulesOnly": {
              "title": "Rules only",
              "type": "boolean",
              "default": false,
              "description": "Do not publish accessories to HomeKit. Devices stay usable as rule triggers and targets."
            },
            "adapter": {
              "title": "Adapter",
              "type": "string",
              "required": true,
              "default": "zigbee2mqtt",
              "oneOf": [
                {
                  "title": "Zigbee2MQTT",
                  "enum": [
                    "zigbee2mqtt"
                  ]
                },
                {
                  "title": "Flat JSON topics",
                  "enum": [
                    "json-topic"
                  ]
                }
              ]
            },
            "baseTopic": {
              "title": "Base topic",
              "type": "string",
              "required": true,
              "default": "zigbee2mqtt",
              "description": "The prefix this source publishes everything under."
            },
            "topics": {
              "title": "Topic filter",
              "type": "string",
              "description": "Which topics to watch, as an MQTT filter. Everything under the base topic by default. Narrow it with a filter of your own, where + stands for one level and # for the rest: sensors/+/state, or sensors/#.",
              "condition": {
                "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
              }
            },
            "setTopicSuffix": {
              "title": "Command topic suffix",
              "type": "string",
              "description": "Usually \"set\". Leave empty to make the source read only.",
              "condition": {
                "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
              }
            },
            "devices": {
              "type": "array",
              "condition": {
                "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
              },
              "description": "Functions a device has that it may never report on its own, such as the speed of a fan nobody has changed yet.",
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "title": "Device topic",
                    "type": "string",
                    "description": "The part after the base topic. A device publishing on <base topic>/kitchen_fan is written here as kitchen_fan."
                  },
                  "properties": {
                    "title": "Functions",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "title": "Function"
                    },
                    "description": "One per line. Only these are understood: state, level, speed, swing, temperature, humidity, co2_levels. Anything a device does report is picked up on its own and does not need naming here."
                  }
                }
              },
              "x-schema-form": {
                "expandable": true,
                "expanded": false
              }
            }
          }
        }
      },
      "web": {
        "title": "Web Interface",
        "type": "object",
        "properties": {
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 8888,
            "minimum": 1,
            "maximum": 65535,
            "x-schema-form": {
              "type": "number"
            }
          },
          "zigbee2mqttUrl": {
            "title": "Zigbee2MQTT frontend",
            "type": "string",
            "placeholder": "http://homebridge.local:8080",
            "description": "Optional. Adds a link to the Zigbee2MQTT interface in the tab bar."
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": true,
            "x-schema-form": {
              "type": "password"
            },
            "description": "Required to open the web interface. It can switch your devices, so the interface will not start without one."
          }
        }
      },
      "location": {
        "title": "Location",
        "type": "object",
        "properties": {
          "latitude": {
            "title": "Latitude",
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "placeholder": "52.37",
            "x-schema-form": {
              "type": "number"
            }
          },
          "longitude": {
            "title": "Longitude",
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "placeholder": "4.90",
            "x-schema-form": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    {
      "type": "fieldset",
      "title": "MQTT Broker",
      "items": [
        "broker.address",
        "broker.requiresAuth",
        {
          "key": "broker.username",
          "condition": {
            "functionBody": "return model.broker && model.broker.requiresAuth;"
          }
        },
        {
          "key": "broker.password",
          "condition": {
            "functionBody": "return model.broker && model.broker.requiresAuth;"
          }
        },
        "broker.clientId"
      ]
    },
    {
      "key": "sources",
      "type": "array",
      "title": "Sources",
      "items": [
        "sources[].id",
        "sources[].rulesOnly",
        "sources[].adapter",
        "sources[].baseTopic",
        {
          "key": "sources[].topics",
          "condition": {
            "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
          }
        },
        {
          "key": "sources[].setTopicSuffix",
          "condition": {
            "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
          }
        },
        {
          "key": "sources[].devices",
          "type": "array",
          "title": "Described devices",
          "expandable": true,
          "expanded": false,
          "condition": {
            "functionBody": "return model.sources[arrayIndices].adapter === 'json-topic';"
          },
          "items": [
            "sources[].devices[].topic",
            {
              "key": "sources[].devices[].properties",
              "type": "array",
              "items": [
                "sources[].devices[].properties[]"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Web Interface",
      "items": [
        "web.port",
        "web.password",
        "web.zigbee2mqttUrl"
      ]
    },
    {
      "type": "fieldset",
      "title": "Location",
      "items": [
        "location.latitude",
        "location.longitude"
      ]
    }
  ]
}
